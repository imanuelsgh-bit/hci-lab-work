x=y=0

while True:
    print("Options")
    print("[1] Location")
    print("[2] Move")
    print("[3] Reset")
    print("[4] Exit")
    choice = int(input("Choose an option: "))
    if choice == 1: 
        print("Robby is currently at", x, y)
    elif choice == 2:
        direction = input("Enter direction (N/S/E/W): ")
        distance = int(input("Enter distance: "))
        if (direction == "N" or direction == "E") and distance > 0:
            if direction == "N":
                y += distance
            else:
                x += distance
        if (direction == "S" or direction == "W") and distance > 0:
            if direction == "S":
                y -= distance
            else:
                x -= distance
        else: 
            print("Invalid direction + distance")
    elif choice == 3:
        print("Robby reset at ",x, y)
        x = y = 0
    elif choice == 4:
        break
print("Goodbye")


